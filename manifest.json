{
  "manifest_version": 3,
  "name": "网申助手",
  "description": "通用网申自动填表：本地资料 + AI 理解表单，适配任意网站。",
  "version": "3.9.0",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/pages/popup.html",
    "default_title": "网申助手"
  },
  "options_page": "src/pages/options.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/core/text.js",
        "src/core/util.js",
        "src/core/regions-gb.js",
        "src/core/region.js",
        "src/core/convert.js",
        "src/core/profile.js",
        "src/core/mapping.js",
        "src/runtime/catalog.js",
        "src/runtime/context.js",
        "src/learning/memory.js",
        "src/learning/scoped-memory.js",
        "src/core/files.js",
        "src/adapters/registry.js",
        "src/adapters/moka/mapping.js",
        "src/adapters/beisen/mapping.js",
        "src/adapters/hotjob/mapping.js",
        "src/adapters/feishu/mapping.js",
        "src/adapters/job51/mapping.js",
        "src/adapters/job51v/mapping.js",
        "src/adapters/overrides.js",
        "src/runtime/rpc.js",
        "src/diagnostics/diagnostics.js",
        "src/fallback/scan.js",
        "src/fallback/controls.js",
        "src/fallback/dates.js",
        "src/fallback/engine.js",
        "src/fallback/field-fallback.js",
        "src/workflow/attachments.js",
        "src/workflow/engine.js",
        "src/ui/panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/runtime/catalog.js",
        "src/runtime/page-runtime.js",
        "src/adapters/moka/page.js",
        "src/adapters/beisen/page.js",
        "src/adapters/hotjob/page.js",
        "src/adapters/feishu/page.js",
        "src/adapters/job51/page.js",
        "src/adapters/job51v/page.js",
        "src/fallback/bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/runtime/catalog.js",
        "src/runtime/page-runtime.js",
        "src/adapters/moka/page.js",
        "src/adapters/beisen/page.js",
        "src/adapters/hotjob/page.js",
        "src/adapters/feishu/page.js",
        "src/adapters/job51/page.js",
        "src/adapters/job51v/page.js",
        "src/fallback/bridge.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "fill": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "填写当前页面空白字段"
    }
  }
}
